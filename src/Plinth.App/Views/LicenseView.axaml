<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Plinth.App.ViewModels"
             xmlns:loc="using:Plinth.App.Localization"
             x:Class="Plinth.App.Views.LicenseView"
             x:DataType="vm:LicenseViewModel">
  <Grid Margin="{DynamicResource PlinthPageMargin}" RowDefinitions="Auto,Auto,*,Auto">
    <SelectableTextBlock Text="{loc:T license.title}" FontSize="19" FontWeight="SemiBold"
               Margin="0,0,0,12" />
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
      <Button Content="{loc:T license.reload}" Command="{Binding LoadCommand}" />
      <ProgressBar Width="100" IsIndeterminate="True" IsVisible="{Binding IsBusy}"
                   AutomationProperties.Name="{loc:T license.status.loading}" />
    </StackPanel>
    <TextBox Grid.Row="2" Text="{Binding Text, Mode=OneWay}" IsReadOnly="True"
             AcceptsReturn="True" TextWrapping="NoWrap"
             HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
             ScrollViewer.HorizontalScrollBarVisibility="Auto"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             AutomationProperties.Name="{loc:T license.title}" />
    <SelectableTextBlock Grid.Row="3" Text="{Binding StatusText}" TextWrapping="Wrap"
               Margin="0,12,0,0" Foreground="{DynamicResource PlinthSubtleForegroundBrush}" />
  </Grid>
</UserControl>
