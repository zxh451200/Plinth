<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Plinth.App.ViewModels"
        xmlns:nav="using:Plinth.App.Navigation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="Plinth.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding AppTitle}"
        Width="1200" Height="720"
        MinWidth="960" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FontSize="13"
        Foreground="{DynamicResource PlinthForegroundBrush}"
        Background="{DynamicResource PlinthBackgroundBrush}">

  <!-- 快捷键集中在这里定义,菜单项用 InputGesture 只做提示(§2.2) -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseTabCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}" />
    <KeyBinding Gesture="F1" Command="{Binding ShowAboutCommand}" />
  </Window.KeyBindings>

  <!-- 文档标签比 Fluent 默认的表单标签更紧凑 -->
  <Window.Styles>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="12,0" />
    </Style>
  </Window.Styles>

  <!-- 菜单(§2.2):只放当前已经实现、点了确实有作用的命令 -->
  <DockPanel LastChildFill="True">

    <Menu DockPanel.Dock="Top"
          Background="{DynamicResource PlinthPanelBrush}"
          BorderBrush="{DynamicResource PlinthBorderBrush}"
          BorderThickness="0,0,0,1">
      <MenuItem Header="文件(_F)">
        <MenuItem Header="关闭当前标签"
                  Command="{Binding CloseTabCommand}"
                  InputGesture="Ctrl+W" />
        <MenuItem Header="关闭全部标签"
                  Command="{Binding CloseAllTabsCommand}" />
        <Separator />
        <MenuItem Header="退出" Command="{Binding ExitCommand}" />
      </MenuItem>
      <MenuItem Header="查看(_V)">
        <MenuItem Header="导航面板"
                  ToggleType="CheckBox"
                  IsChecked="{Binding IsSidebarVisible, Mode=TwoWay}" />
      </MenuItem>
      <MenuItem Header="数据(_D)">
        <MenuItem Header="刷新" Command="{Binding RefreshCommand}" InputGesture="F5" />
      </MenuItem>
      <MenuItem Header="工具(_T)">
        <MenuItem Header="打开数据目录" Command="{Binding OpenDataFolderCommand}" />
        <MenuItem Header="打开日志目录" Command="{Binding OpenLogFolderCommand}" />
      </MenuItem>
      <MenuItem Header="帮助(_H)">
        <MenuItem Header="关于 Plinth" Command="{Binding ShowAboutCommand}" InputGesture="F1" />
      </MenuItem>
    </Menu>

    <!-- 工具栏 -->
    <Border DockPanel.Dock="Top"
            Padding="8,6"
            Background="{DynamicResource PlinthPanelBrush}"
            BorderBrush="{DynamicResource PlinthBorderBrush}"
            BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Content="刷新"
                Command="{Binding RefreshCommand}"
                ToolTip.Tip="刷新当前页面 (F5)" />
        <Button Content="关闭标签"
                Command="{Binding CloseTabCommand}"
                ToolTip.Tip="关闭当前标签 (Ctrl+W)" />
        <Button Content="日志目录"
                Command="{Binding OpenLogFolderCommand}"
                ToolTip.Tip="打开日志所在目录" />
      </StackPanel>
    </Border>

    <!-- 状态栏 -->
    <Border DockPanel.Dock="Bottom"
            Padding="12,5"
            Background="{DynamicResource PlinthPanelBrush}"
            BorderBrush="{DynamicResource PlinthBorderBrush}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding StatusMessage}"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource PlinthSubtleForegroundBrush}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14">
          <TextBlock Text="{Binding TabCountText}"
                     Foreground="{DynamicResource PlinthSubtleForegroundBrush}" />
          <TextBlock Text="{Binding VersionText}"
                     Foreground="{DynamicResource PlinthSubtleForegroundBrush}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 导航 + 工作区 -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Width="260"
              IsVisible="{Binding IsSidebarVisible}"
              Background="{DynamicResource PlinthPanelBrush}"
              BorderBrush="{DynamicResource PlinthBorderBrush}"
              BorderThickness="0,0,1,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top"
                     Text="导航"
                     Margin="14,12,14,4"
                     FontSize="11"
                     Foreground="{DynamicResource PlinthSubtleForegroundBrush}" />
          <ListBox x:Name="NavigationList"
                   ItemsSource="{Binding NavigationItems}"
                   SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="6,0"
                   Tapped="OnNavigationTapped">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="nav:NavigationItem">
                <TextBlock Text="{Binding Title}" Padding="10,7" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1"
                    Width="4"
                    IsVisible="{Binding IsSidebarVisible}"
                    ResizeDirection="Columns"
                    Background="Transparent" />

      <Panel Grid.Column="2">
        <!-- 空状态 -->
        <StackPanel IsVisible="{Binding !HasTabs}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="6">
          <TextBlock Text="从左侧导航打开一个页面"
                     HorizontalAlignment="Center"
                     Foreground="{DynamicResource PlinthSubtleForegroundBrush}" />
          <TextBlock Text="Ctrl+W 关闭标签 · F5 刷新 · F1 关于"
                     HorizontalAlignment="Center"
                     FontSize="11"
                     Foreground="{DynamicResource PlinthSubtleForegroundBrush}" />
        </StackPanel>

        <!-- 标签工作区:内容由 ViewLocator 按 XxxViewModel → XxxView 解析 -->
        <TabControl ItemsSource="{Binding Tabs}"
                    SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                    IsVisible="{Binding HasTabs}"
                    Background="Transparent"
                    Padding="0">
          <TabControl.ItemTemplate>
            <DataTemplate x:DataType="vm:WorkspaceTabViewModel">
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,2">
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                <Button Content="✕"
                        Padding="4,0"
                        FontSize="10"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip.Tip="关闭标签"
                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CloseTabItemCommand}"
                        CommandParameter="{Binding}" />
              </StackPanel>
            </DataTemplate>
          </TabControl.ItemTemplate>
          <TabControl.ContentTemplate>
            <DataTemplate x:DataType="vm:WorkspaceTabViewModel">
              <ContentControl Content="{Binding Content}" />
            </DataTemplate>
          </TabControl.ContentTemplate>
        </TabControl>
      </Panel>
    </Grid>
  </DockPanel>
</Window>
