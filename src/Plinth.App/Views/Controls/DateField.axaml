<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Plinth.App.Localization"
             x:Class="Plinth.App.Views.Controls.DateField">

  <UserControl.Styles>
    <Style Selector="TextBlock.weekday">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource PlinthSubtleForegroundBrush}" />
    </Style>
    <Style Selector="Button#FieldButton">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{DynamicResource PlinthPanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PlinthBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBlock.placeholder">
      <Setter Property="Foreground" Value="{DynamicResource PlinthSubtleForegroundBrush}" />
    </Style>
    <Style Selector="Button.day">
      <Setter Property="MinWidth" Value="30" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="15" />
    </Style>
    <Style Selector="Button.day:pointerover">
      <Setter Property="Background" Value="{DynamicResource PlinthNavHoverBrush}" />
    </Style>
    <Style Selector="Button.day.other">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Button.day.today">
      <Setter Property="Foreground" Value="{DynamicResource PlinthAccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.day.selected">
      <Setter Property="Background" Value="{DynamicResource PlinthAccentBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.day.selected:pointerover">
      <Setter Property="Background" Value="{DynamicResource PlinthAccentBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="MinWidth" Value="24" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource PlinthSubtleForegroundBrush}" />
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="{DynamicResource PlinthNavHoverBrush}" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource PlinthSubtleForegroundBrush}" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.link:pointerover">
      <Setter Property="Background" Value="{DynamicResource PlinthNavHoverBrush}" />
    </Style>
  </UserControl.Styles>

  <Button x:Name="FieldButton" Classes="field" Click="OnFieldClick">
    <Button.Flyout>
      <Flyout Placement="BottomEdgeAlignedLeft">
        <Border x:Name="PopupCard" BorderThickness="0" CornerRadius="8" Padding="12" BoxShadow="0 6 16 0 #33000000">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBlock x:Name="MonthText" VerticalAlignment="Center"
                         FontWeight="SemiBold" FontSize="13" Margin="2,0,0,0" />
              <Button x:Name="PreviousButton" Grid.Column="1" Classes="nav" Content="&#xE76B;" Click="OnPreviousMonth"
                      FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Margin="0,0,2,0" />
              <Button x:Name="NextButton" Grid.Column="2" Classes="nav" Content="&#xE76C;" Click="OnNextMonth"
                      FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" />
            </Grid>
            <Grid x:Name="WeekdayHeader" ColumnDefinitions="*,*,*,*,*,*,*" Margin="0,2,0,0" />
            <UniformGrid x:Name="DaysGrid" Columns="7" Rows="6" />
            <Grid ColumnDefinitions="*,*" Margin="0,6,0,0">
              <Button Content="{loc:T calendar.today}" Classes="link" HorizontalAlignment="Left" Click="OnToday" />
              <Button Grid.Column="1" Content="{loc:T calendar.clear}" Classes="link" HorizontalAlignment="Right"
                      Click="OnClear" />
            </Grid>
          </StackPanel>
        </Border>
      </Flyout>
    </Button.Flyout>
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock x:Name="ValueText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Column="1" Text="&#xE787;"
                 FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="12"
                 Foreground="{DynamicResource PlinthSubtleForegroundBrush}"
                 VerticalAlignment="Center" Margin="8,0,0,0"
                 AutomationProperties.AccessibilityView="Raw" />
    </Grid>
  </Button>
</UserControl>
