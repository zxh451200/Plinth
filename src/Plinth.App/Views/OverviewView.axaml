<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Plinth.App.ViewModels"
             xmlns:loc="using:Plinth.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Plinth.App.Views.OverviewView"
             x:DataType="vm:OverviewViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{DynamicResource PlinthSubtleForegroundBrush}" />
      <Setter Property="Margin" Value="0,0,12,10" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="{DynamicResource PlinthPageMargin}" Spacing="{DynamicResource PlinthSectionSpacing}" HorizontalAlignment="Left">
      <TextBlock Text="{loc:T overview.title}" FontSize="19" FontWeight="SemiBold" />
      <TextBlock MaxWidth="760"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource PlinthSubtleForegroundBrush}"
                 Text="{loc:T overview.intro}" />

      <Border MaxWidth="760"
              HorizontalAlignment="Left"
              Background="{DynamicResource PlinthPanelBrush}"
              BorderBrush="{DynamicResource PlinthBorderBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="16,14"
              BoxShadow="0 1 3 0 #1A000000">
        <Grid ColumnDefinitions="150,*"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="{loc:T overview.version}" />
          <TextBlock Grid.Row="0" Grid.Column="1" Classes="value" Text="{Binding Version}" />

          <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="{loc:T overview.runtime}" />
          <TextBlock Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding Framework}" />

          <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="{loc:T overview.os}" />
          <TextBlock Grid.Row="2" Grid.Column="1" Classes="value" Text="{Binding OperatingSystem}" />

          <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="{loc:T overview.arch}" />
          <TextBlock Grid.Row="3" Grid.Column="1" Classes="value" Text="{Binding Architecture}" />

          <TextBlock Grid.Row="4" Grid.Column="0" Classes="label" Text="{loc:T overview.dataDir}" />
          <TextBlock Grid.Row="4" Grid.Column="1" Classes="value" Text="{Binding DataDirectory}" />

          <TextBlock Grid.Row="5" Grid.Column="0" Classes="label" Text="{loc:T overview.logDir}" />
          <TextBlock Grid.Row="5" Grid.Column="1" Classes="value" Text="{Binding LogDirectory}" />

          <TextBlock Grid.Row="6" Grid.Column="0" Classes="label" Text="{loc:T overview.logFiles}" />
          <TextBlock Grid.Row="6" Grid.Column="1" Classes="value" Text="{Binding LogSummary}" />
        </Grid>
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="{loc:T overview.openData}" Command="{Binding OpenDataFolderCommand}" />
        <Button Content="{loc:T overview.openLogs}" Command="{Binding OpenLogFolderCommand}" />
      </StackPanel>

      <TextBlock Text="{Binding ActionHint}"
                 IsVisible="{Binding ActionHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 FontSize="12"
                 Foreground="{DynamicResource PlinthSubtleForegroundBrush}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
