<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Plinth.App.ViewModels"
             xmlns:loc="using:Plinth.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Plinth.App.Views.BackupView"
             x:DataType="vm:BackupViewModel">

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="{DynamicResource PlinthPageMargin}" Spacing="{DynamicResource PlinthSectionSpacing}" HorizontalAlignment="Left" MaxWidth="640">
    <SelectableTextBlock Text="{loc:T backup.title}" FontSize="19" FontWeight="SemiBold" />
    <Border Background="{DynamicResource PlinthPanelBrush}" BorderBrush="{DynamicResource PlinthBorderBrush}"
            BorderThickness="1" CornerRadius="6" Padding="{DynamicResource PlinthPanelPadding}"
            BoxShadow="0 1 3 0 #1A000000">
      <StackPanel Spacing="{DynamicResource PlinthSectionSpacing}">
        <SelectableTextBlock Text="{loc:T backup.intro}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource PlinthSubtleForegroundBrush}" />
        <SelectableTextBlock Text="{Binding ServerBackupNotice}" IsVisible="{Binding IsServerDatabase}"
                   TextWrapping="Wrap" Foreground="{DynamicResource PlinthErrorBrush}" />

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="{loc:T backup.create}" Click="OnBackupClick" IsEnabled="{Binding CanChooseFile}" />
          <Button Content="{loc:T backup.restore}" Click="OnRestoreClick" IsEnabled="{Binding CanChooseFile}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <StackPanel IsVisible="{Binding HasBackupPreview}" Spacing="8">
      <SelectableTextBlock Text="{Binding CreatePreview}" TextWrapping="Wrap" />
      <Button Content="{loc:T backup.confirmCreate}" Command="{Binding ConfirmBackupCommand}"
              IsEnabled="{Binding CanChooseFile}" />
      <SelectableTextBlock Text="{loc:T backup.exit.snapshotNote}" TextWrapping="Wrap" />
      <Button Content="{loc:T backup.exit.confirm}" Click="OnBackupAndExitClick"
              IsEnabled="{Binding CanChooseFile}" />
    </StackPanel>
    <StackPanel IsVisible="{Binding HasRestorePreview}" Spacing="8">
      <SelectableTextBlock Text="{Binding RestorePreview}" TextWrapping="Wrap" />
      <CheckBox Content="{loc:T backup.confirm}" IsChecked="{Binding RestoreConfirmed}" />
      <Button Content="{loc:T backup.confirmRestore}" Command="{Binding ConfirmRestoreCommand}"
              IsEnabled="{Binding CanConfirmRestore}" />
    </StackPanel>
    <!-- 定时自动备份:设置即改即存;服务器库由服务器备份,这一卡不显示 -->
    <Border IsVisible="{Binding CanEditAutoBackup}"
            Background="{DynamicResource PlinthPanelBrush}" BorderBrush="{DynamicResource PlinthBorderBrush}"
            BorderThickness="1" CornerRadius="6" Padding="{DynamicResource PlinthPanelPadding}"
            BoxShadow="0 1 3 0 #1A000000">
      <StackPanel Spacing="12">
        <SelectableTextBlock Text="{loc:T backup.auto.title}" FontWeight="SemiBold" />
        <SelectableTextBlock Text="{loc:T backup.auto.hint}" TextWrapping="Wrap"
                   Foreground="{DynamicResource PlinthSubtleForegroundBrush}" />
        <CheckBox Content="{loc:T backup.auto.enabled}" IsChecked="{Binding IsAutoBackupEnabled}" />
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowAutoBackupSchedule}">
          <TextBlock Text="{loc:T backup.auto.intervalDays}" VerticalAlignment="Center" />
          <NumericUpDown Value="{Binding AutoBackupIntervalDays}" Minimum="1" Maximum="365"
                         Width="110" MinHeight="{DynamicResource PlinthControlHeight}" />
          <TextBlock Text="{loc:T backup.auto.keepCount}" VerticalAlignment="Center" Margin="16,0,0,0" />
          <NumericUpDown Value="{Binding AutoBackupKeepCount}" Minimum="1" Maximum="100"
                         Width="110" MinHeight="{DynamicResource PlinthControlHeight}" />
        </StackPanel>
        <SelectableTextBlock Text="{Binding AutoBackupStatusText}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <SelectableTextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
  </StackPanel>
  </ScrollViewer>
</UserControl>
