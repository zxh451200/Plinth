<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Plinth.App.ViewModels"
             xmlns:loc="using:Plinth.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Plinth.App.Views.BackupView"
             x:DataType="vm:BackupViewModel">

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="{DynamicResource PlinthPageMargin}" Spacing="{DynamicResource PlinthSectionSpacing}" HorizontalAlignment="Left" MaxWidth="640">
    <TextBlock Text="{loc:T backup.title}" FontSize="19" FontWeight="SemiBold" />
    <Border Background="{DynamicResource PlinthPanelBrush}" BorderBrush="{DynamicResource PlinthBorderBrush}"
            BorderThickness="1" CornerRadius="6" Padding="{DynamicResource PlinthPanelPadding}"
            BoxShadow="0 1 3 0 #1A000000">
      <StackPanel Spacing="{DynamicResource PlinthSectionSpacing}">
        <TextBlock Text="{loc:T backup.intro}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource PlinthSubtleForegroundBrush}" />

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="{loc:T backup.create}" Click="OnBackupClick" IsEnabled="{Binding CanChooseFile}" />
          <Button Content="{loc:T backup.restore}" Click="OnRestoreClick" IsEnabled="{Binding CanChooseFile}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <StackPanel IsVisible="{Binding HasBackupPreview}" Spacing="8">
      <TextBlock Text="{Binding CreatePreview}" TextWrapping="Wrap" />
      <Button Content="{loc:T backup.confirmCreate}" Command="{Binding ConfirmBackupCommand}"
              IsEnabled="{Binding CanChooseFile}" />
    </StackPanel>
    <StackPanel IsVisible="{Binding HasRestorePreview}" Spacing="8">
      <TextBlock Text="{Binding RestorePreview}" TextWrapping="Wrap" />
      <CheckBox Content="{loc:T backup.confirm}" IsChecked="{Binding RestoreConfirmed}" />
      <Button Content="{loc:T backup.confirmRestore}" Command="{Binding ConfirmRestoreCommand}"
              IsEnabled="{Binding CanConfirmRestore}" />
    </StackPanel>
    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
  </StackPanel>
  </ScrollViewer>
</UserControl>
