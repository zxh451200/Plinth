<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 设计令牌(§2.3):浅色/深色都是正式主题,界面统一用 DynamicResource 引用 -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="PlinthBackgroundBrush" Color="#F4F5F7" />
      <SolidColorBrush x:Key="PlinthPanelBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="PlinthBorderBrush" Color="#E3E6EA" />
      <SolidColorBrush x:Key="PlinthForegroundBrush" Color="#1F2328" />
      <SolidColorBrush x:Key="PlinthSubtleForegroundBrush" Color="#6B7280" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="PlinthBackgroundBrush" Color="#1B1D21" />
      <SolidColorBrush x:Key="PlinthPanelBrush" Color="#232529" />
      <SolidColorBrush x:Key="PlinthBorderBrush" Color="#33373D" />
      <SolidColorBrush x:Key="PlinthForegroundBrush" Color="#E6E8EB" />
      <SolidColorBrush x:Key="PlinthSubtleForegroundBrush" Color="#9AA1A9" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
