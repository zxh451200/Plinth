<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 设计令牌(§2.3):浅色/深色都是正式主题,界面统一用 DynamicResource 引用 -->
  <FontFamily x:Key="PlinthFontFamily">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
  <x:Double x:Key="PlinthBodySize">13</x:Double>
  <x:Double x:Key="PlinthTitleSize">22</x:Double>
  <x:Double x:Key="PlinthCaptionSize">11</x:Double>
  <x:Double x:Key="PlinthPageTitleSize">19</x:Double>
  <Thickness x:Key="PlinthPageMargin">24</Thickness>
  <Thickness x:Key="PlinthPanelPadding">18</Thickness>
  <x:Double x:Key="PlinthSectionSpacing">16</x:Double>
  <x:Double x:Key="PlinthControlHeight">34</x:Double>
  <Thickness x:Key="PlinthControlPadding">12,6</Thickness>
  <x:Double x:Key="PlinthRowHeight">38</x:Double>
  <Thickness x:Key="PlinthRowPadding">10,6</Thickness>
  <Thickness x:Key="PlinthToolbarPadding">10,6</Thickness>
  <Thickness x:Key="PlinthNavigationPadding">10,8</Thickness>
  <CornerRadius x:Key="PlinthPanelCornerRadius">10</CornerRadius>
  <CornerRadius x:Key="PlinthControlCornerRadius">6</CornerRadius>
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="PlinthBackgroundBrush" Color="#F4F6F8" />
      <SolidColorBrush x:Key="PlinthPanelBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="PlinthSidebarBrush" Color="#FAFBFC" />
      <SolidColorBrush x:Key="PlinthToolbarBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="PlinthBorderBrush" Color="#E4E7EC" />
      <SolidColorBrush x:Key="PlinthBorderStrongBrush" Color="#D0D5DD" />
      <SolidColorBrush x:Key="PlinthForegroundBrush" Color="#101828" />
      <SolidColorBrush x:Key="PlinthSubtleForegroundBrush" Color="#667085" />
      <SolidColorBrush x:Key="PlinthErrorBrush" Color="#B42318" />
      <SolidColorBrush x:Key="PlinthSuccessBrush" Color="#067647" />
      <SolidColorBrush x:Key="PlinthWarningBrush" Color="#B54708" />
      <SolidColorBrush x:Key="PlinthAccentBrush" Color="#2563EB" />
      <SolidColorBrush x:Key="PlinthAccentHoverBrush" Color="#1D4ED8" />
      <SolidColorBrush x:Key="PlinthAccentSubtleBrush" Color="#EFF4FF" />
      <SolidColorBrush x:Key="PlinthNavHoverBrush" Color="#F2F4F7" />
      <SolidColorBrush x:Key="PlinthNavSelectedBrush" Color="#EAF1FF" />
      <SolidColorBrush x:Key="PlinthTableHeaderBrush" Color="#F9FAFB" />
      <SolidColorBrush x:Key="PlinthRowHoverBrush" Color="#F7F9FC" />
      <SolidColorBrush x:Key="PlinthRowSelectedBrush" Color="#EFF5FF" />
      <SolidColorBrush x:Key="PlinthFocusBrush" Color="#2563EB" />
      <SolidColorBrush x:Key="PlinthSelectionForegroundBrush" Color="#FFFFFF" />
      <!-- 输入框选区：强调色降透明度，文字保持原前景色,不像实心蓝块压住数字 -->
      <SolidColorBrush x:Key="PlinthTextSelectionBrush" Color="#382563EB" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="PlinthBackgroundBrush" Color="#0F1115" />
      <SolidColorBrush x:Key="PlinthPanelBrush" Color="#161A20" />
      <SolidColorBrush x:Key="PlinthSidebarBrush" Color="#13161B" />
      <SolidColorBrush x:Key="PlinthToolbarBrush" Color="#161A20" />
      <SolidColorBrush x:Key="PlinthBorderBrush" Color="#262C35" />
      <SolidColorBrush x:Key="PlinthBorderStrongBrush" Color="#394150" />
      <SolidColorBrush x:Key="PlinthForegroundBrush" Color="#E6E9EF" />
      <SolidColorBrush x:Key="PlinthSubtleForegroundBrush" Color="#98A2B3" />
      <SolidColorBrush x:Key="PlinthErrorBrush" Color="#F97066" />
      <SolidColorBrush x:Key="PlinthSuccessBrush" Color="#75E0A7" />
      <SolidColorBrush x:Key="PlinthWarningBrush" Color="#FDB022" />
      <SolidColorBrush x:Key="PlinthAccentBrush" Color="#6EA8FF" />
      <SolidColorBrush x:Key="PlinthAccentHoverBrush" Color="#8AB8FF" />
      <SolidColorBrush x:Key="PlinthAccentSubtleBrush" Color="#17233A" />
      <SolidColorBrush x:Key="PlinthNavHoverBrush" Color="#1C2129" />
      <SolidColorBrush x:Key="PlinthNavSelectedBrush" Color="#1A2A44" />
      <SolidColorBrush x:Key="PlinthTableHeaderBrush" Color="#1A1F26" />
      <SolidColorBrush x:Key="PlinthRowHoverBrush" Color="#1B212A" />
      <SolidColorBrush x:Key="PlinthRowSelectedBrush" Color="#1A2A40" />
      <SolidColorBrush x:Key="PlinthFocusBrush" Color="#6EA8FF" />
      <SolidColorBrush x:Key="PlinthSelectionForegroundBrush" Color="#0F1115" />
      <SolidColorBrush x:Key="PlinthTextSelectionBrush" Color="#4D6EA8FF" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
