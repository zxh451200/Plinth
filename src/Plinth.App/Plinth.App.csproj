<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 与便携包／安装包共用同一还原图；普通 CI 仍可在宿主平台运行测试。 -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\plinth.ico</ApplicationIcon>
    <DefineConstants Condition="'$(PlinthEnableXlsx)' == 'true'">$(DefineConstants);PLINTH_XLSX</DefineConstants>
    <PlinthEnableDockBusiness Condition="'$(PlinthEnableDockBusiness)' == ''">false</PlinthEnableDockBusiness>
    <DefineConstants Condition="'$(PlinthEnableDockBusiness)' == 'true'">$(DefineConstants);PLINTH_DOCK_BUSINESS</DefineConstants>
    <!-- XLSX 默认关闭：排除 ClosedXML 运行时资产，避免分发其内嵌 Carlito 字体。 -->
    <ClosedXmlExcludeAssets Condition="'$(PlinthEnableXlsx)' != 'true'">runtime</ClosedXmlExcludeAssets>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Plinth.App.Tests" />
    <AvaloniaResource Include="Assets\**" />
    <None Update="plinth.install.lock" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Resources\notify.ps1" Link="notify.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="ClosedXML" ExcludeAssets="$(ClosedXmlExcludeAssets)" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Duende.IdentityModel.OidcClient" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <!-- 给 dotnet ef 命令和 AppDbContextFactory 用,不传递给引用本项目的其它项目 -->
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup Condition="'$(PlinthEnableDockBusiness)' == 'true'">
    <PackageReference Include="Dock.Avalonia" />
    <PackageReference Include="Dock.Model.Mvvm" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" />
    <PackageReference Include="Dock.Serializer.SystemTextJson" />
    <Compile Include="../Plinth.DockDemo/DemoDockFactory.cs" Link="Modules/DockOptional/DockDemo/DemoDockFactory.cs" />
    <Compile Include="../Plinth.DockDemo/DockLayoutValidation.cs" Link="Modules/DockOptional/DockDemo/DockLayoutValidation.cs" />
    <Compile Include="../Plinth.DockDemo/DockWorkspace.cs" Link="Modules/DockOptional/DockDemo/DockWorkspace.cs" />
    <Compile Include="../Plinth.DockDemo/DockDemoWindow.cs" Link="Modules/DockOptional/DockDemo/DockDemoWindow.cs" />
    <Compile Include="../Plinth.DockDemo/Business/DockBusinessPane.cs" Link="Modules/DockOptional/DockDemo/DockBusinessPane.cs" />
    <Compile Include="../Plinth.DockDemo/Business/DockBusinessWorkspaceLauncher.cs" Link="Modules/DockOptional/DockDemo/DockBusinessWorkspaceLauncher.cs" />
  </ItemGroup>
</Project>
