<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Plinth.App.App"
             xmlns:local="using:Plinth.App"
             RequestedThemeVariant="Default">
             <!-- "Default" 跟随系统;"Light" / "Dark" 可显式指定 -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Plinth.App/Styles/DesignTokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Button:not(.tabClose)">
            <Setter Property="MinHeight" Value="{DynamicResource PlinthControlHeight}" />
            <Setter Property="Padding" Value="{DynamicResource PlinthControlPadding}" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="{DynamicResource PlinthControlHeight}" />
            <Setter Property="Padding" Value="{DynamicResource PlinthControlPadding}" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="{DynamicResource PlinthControlHeight}" />
            <Setter Property="Padding" Value="{DynamicResource PlinthControlPadding}" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="MinHeight" Value="{DynamicResource PlinthControlHeight}" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="MinHeight" Value="{DynamicResource PlinthControlHeight}" />
        </Style>
        <Style Selector="TableViewRow">
            <Setter Property="MinHeight" Value="{DynamicResource PlinthRowHeight}" />
            <Setter Property="Padding" Value="{DynamicResource PlinthRowPadding}" />
        </Style>
    </Application.Styles>
</Application>
