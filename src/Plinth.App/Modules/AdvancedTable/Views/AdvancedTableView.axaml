<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Plinth.App.Modules.AdvancedTable.ViewModels"
             xmlns:loc="using:Plinth.App.Localization"
             x:Class="Plinth.App.Modules.AdvancedTable.Views.AdvancedTableView"
             x:DataType="vm:AdvancedTableViewModel">
  <Grid Margin="{DynamicResource PlinthPageMargin}" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="12">
    <StackPanel Spacing="4">
      <SelectableTextBlock Text="{loc:T nav.advancedTable}" FontSize="19" FontWeight="SemiBold" />
      <SelectableTextBlock Text="{loc:T advanced.notice}" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="ImportButton" Content="{loc:T advanced.import}" Click="OnImportClick" IsEnabled="{Binding CanInteract}" />
        <Button x:Name="CancelImportButton" Content="{loc:T advanced.cancel}" Command="{Binding CancelImportCommand}" />
      </StackPanel>
    </StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="2*,*,Auto,Auto" ColumnSpacing="8">
      <TextBox x:Name="SearchBox" Grid.Column="0" Text="{Binding SearchText}" MaxLength="200"
               Watermark="{loc:T advanced.search}" AutomationProperties.Name="{loc:T advanced.search}" />
      <ComboBox Grid.Column="1" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"
                PlaceholderText="{loc:T advanced.all}" AutomationProperties.Name="{loc:T advanced.groupFilter}" />
      <Button x:Name="ApplyButton" Grid.Column="2" Content="{loc:T advanced.apply}" Command="{Binding ApplyFilterCommand}" />
      <Button Grid.Column="3" Content="{loc:T advanced.export}" Command="{Binding ExportCommand}" />
    </Grid>
    <TableView x:Name="PilotTable" Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" IsEnabled="{Binding !IsBusy}"
               AutomationProperties.Name="{loc:T nav.advancedTable}">
      <TableView.Columns>
        <TableViewColumn x:DataType="vm:AdvancedTableRowViewModel" Header="{loc:T advanced.colKind}" Binding="{Binding KindText}" Width="130" />
        <TableViewColumn x:DataType="vm:AdvancedTableRowViewModel" Header="ID" Binding="{Binding Id}" Width="120" />
        <TableViewColumn x:DataType="vm:AdvancedTableRowViewModel" Header="{loc:T advanced.colGroup}" Binding="{Binding Group}" Width="120" />
        <TableViewColumn x:DataType="vm:AdvancedTableRowViewModel" Header="{loc:T advanced.colLabel}" Binding="{Binding Label}" Width="260" />
        <TableViewColumn x:DataType="vm:AdvancedTableRowViewModel" Header="{loc:T advanced.colRows}" Binding="{Binding RowCountText}" Width="80" />
        <TableViewColumn x:DataType="vm:AdvancedTableRowViewModel" Header="{loc:T advanced.colQuantity}" Binding="{Binding QuantityText}" Width="100" />
        <TableViewColumn x:DataType="vm:AdvancedTableRowViewModel" Header="{loc:T advanced.colAmount}" Binding="{Binding AmountText}" Width="110" />
      </TableView.Columns>
    </TableView>
    <StackPanel Grid.Row="3" Spacing="4">
      <SelectableTextBlock Text="{Binding ScopeText}" TextWrapping="Wrap" />
      <SelectableTextBlock Text="{Binding TotalText}" />
      <SelectableTextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
    </StackPanel>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
      <Button Content="{loc:T advanced.previous}" Command="{Binding PreviousPageCommand}" />
      <SelectableTextBlock VerticalAlignment="Center" Text="{Binding Page}" />
      <Button Content="{loc:T advanced.next}" Command="{Binding NextPageCommand}" />
    </StackPanel>
    <Border Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Top" Width="280" Margin="0,8,16,0"
            Padding="12" Background="{DynamicResource PlinthPanelBrush}" BorderBrush="{DynamicResource PlinthBorderBrush}"
            BorderThickness="1" IsVisible="{Binding CanEditSelected}">
      <StackPanel Spacing="8">
        <SelectableTextBlock Text="Edit selected detail" FontWeight="SemiBold" />
        <SelectableTextBlock Text="Quantity" />
        <NumericUpDown Value="{Binding EditQuantity}" Minimum="-100000" Maximum="100000" Increment="1" FormatString="0" />
        <SelectableTextBlock Text="Amount" />
        <NumericUpDown Value="{Binding EditAmount}" Minimum="-1000000000000" Maximum="1000000000000"
                       Increment="0.01" FormatString="0.00" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Save" Command="{Binding SaveSelectedCommand}" />
          <Button Content="Cancel" Command="{Binding CancelSelectedCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
