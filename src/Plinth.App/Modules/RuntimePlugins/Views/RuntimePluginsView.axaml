<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Plinth.App.Modules.RuntimePlugins.ViewModels" x:Class="Plinth.App.Modules.RuntimePlugins.Views.RuntimePluginsView" x:DataType="vm:RuntimePluginsViewModel">
  <ScrollViewer><StackPanel Margin="{DynamicResource PlinthPageMargin}" Spacing="12" MaxWidth="720">
    <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding DisabledText}" IsVisible="{Binding !IsConfigured}" Foreground="{DynamicResource PlinthSubtleForegroundBrush}" TextWrapping="Wrap"/>
    <StackPanel IsVisible="{Binding IsConfigured}" Spacing="8"><TextBlock Text="{Binding OperationLabel}"/><ComboBox ItemsSource="{Binding Operations}" SelectedItem="{Binding SelectedOperation}" DisplayMemberBinding="{Binding DisplayName}"/><TextBlock Text="{Binding InputLabel}"/><TextBox Text="{Binding Input}" Watermark="{Binding InputPlaceholder}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="{Binding InvokeText}" Command="{Binding InvokeCommand}"/><Button Content="{Binding CancelText}" Command="{Binding CancelCommand}"/></StackPanel><TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"/><TextBlock Text="{Binding Output}" TextWrapping="Wrap" IsVisible="{Binding Output, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/></StackPanel>
  </StackPanel></ScrollViewer>
</UserControl>
