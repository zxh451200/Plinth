<!-- Classless and reflection-bound so the resource also compiles with PLINTH_XLSX disabled.
     The conditional SpreadsheetView wrapper loads it and wires native storage pickers. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:CompileBindings="False">
  <Grid Margin="{DynamicResource PlinthPageMargin}" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" RowSpacing="{DynamicResource PlinthSectionSpacing}">
    <StackPanel Spacing="6">
      <TextBlock Text="{Binding Labels[Title]}" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Labels[Help]}" TextWrapping="Wrap" />
    </StackPanel>
    <WrapPanel Grid.Row="1">
      <Button x:Name="ChooseFileButton" Content="{Binding Labels[ChooseFile]}" IsEnabled="{Binding CanInteract}" Margin="0,0,8,6" />
      <Button Content="{Binding Labels[Clear]}" Command="{Binding ClearCommand}" Margin="0,0,8,6" />
      <Button Content="{Binding Labels[Cancel]}" Command="{Binding CancelCommand}" Margin="0,0,8,6" />
      <TextBlock Text="{Binding SourceName}" VerticalAlignment="Center" TextWrapping="Wrap" />
    </WrapPanel>
    <StackPanel Grid.Row="2" Spacing="6">
      <TextBlock Text="{Binding Labels[ExportHelp]}" TextWrapping="Wrap" />
      <WrapPanel>
        <TextBox Text="{Binding SearchText}" PlaceholderText="{Binding Labels[Search]}"
                 AutomationProperties.Name="{Binding Labels[Search]}" IsEnabled="{Binding CanInteract}"
                 Width="280" Margin="0,0,8,6" />
        <Button x:Name="ExportButton" Content="{Binding Labels[Export]}" IsEnabled="{Binding CanInteract}" Margin="0,0,8,6" />
      </WrapPanel>
    </StackPanel>
    <TextBlock Grid.Row="3" Text="{Binding Summary}" TextWrapping="Wrap" />
    <Grid Grid.Row="4" RowDefinitions="2*,*" RowSpacing="{DynamicResource PlinthSectionSpacing}">
      <TableView x:Name="PreviewTable" ItemsSource="{Binding PreviewRows}" AutomationProperties.Name="{Binding Labels[Preview]}">
        <TableView.Columns>
          <TableViewColumn Binding="{Binding Row}" Width="70" />
          <TableViewColumn Binding="{Binding Code}" Width="160" />
          <TableViewColumn Binding="{Binding Name}" Width="220" />
          <TableViewColumn Binding="{Binding Remark}" Width="280" />
        </TableView.Columns>
      </TableView>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Issues}" AutomationProperties.Name="{Binding Labels[Errors]}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource PlinthErrorBrush}" Margin="0,2" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
    <StackPanel Grid.Row="5" Spacing="6">
      <CheckBox IsChecked="{Binding Acknowledged}" IsEnabled="{Binding CanInteract}"
                AutomationProperties.Name="{Binding Labels[Acknowledge]}">
        <TextBlock Text="{Binding Labels[Acknowledge]}" TextWrapping="Wrap" />
      </CheckBox>
      <Button Content="{Binding Labels[ConfirmImport]}" Command="{Binding ConfirmImportCommand}" />
    </StackPanel>
    <StackPanel Grid.Row="6" Spacing="5">
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="4" />
      <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
      <TextBox Text="{Binding ExportedPath}" IsReadOnly="True" TextWrapping="Wrap"
               AutomationProperties.Name="{Binding Labels[OutputPath]}" />
    </StackPanel>
  </Grid>
</UserControl>
