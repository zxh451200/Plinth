<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Plinth.App.Modules.OfflineSync.ViewModels" x:Class="Plinth.App.Modules.OfflineSync.Views.OfflineSyncView" x:DataType="vm:OfflineSyncViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24">
    <StackPanel Spacing="5"><TextBlock Text="离线同步试点" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="本地 SQLite 演示传输；当前仓库没有生产 HTTP 契约，本页不会联网。" TextWrapping="Wrap"/><TextBlock Text="账号与部署 scope 已隔离；Uncertain 不自动重试，撤权或换号后操作会被拒绝。" TextWrapping="Wrap"/></StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,16,0,10"><Button Content="刷新" Command="{Binding RefreshCommand}" Margin="0,0,8,4"/><Button Content="离线编辑/保存草稿" Command="{Binding EditOfflineCommand}" IsEnabled="{Binding CanEdit}" Margin="0,0,8,4"/><Button Content="发送一个 Pending" Command="{Binding SyncOneCommand}" IsEnabled="{Binding CanSync}" Margin="0,0,8,4"/><Button Content="接受服务端" Command="{Binding AcceptServerCommand}" IsEnabled="{Binding CanResolve}" Margin="0,0,8,4"/><Button Content="合并为新 Pending" Command="{Binding MergeCommand}" IsEnabled="{Binding CanResolve}" Margin="0,0,8,4"/><Button Content="核对 Uncertain" Command="{Binding ReconcileCommand}" IsEnabled="{Binding CanResolve}" Margin="0,0,8,4"/></WrapPanel>
    <Grid Grid.Row="2" ColumnDefinitions="2*,3*" ColumnSpacing="14"><ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" DisplayMemberBinding="{Binding State}"/><ScrollViewer Grid.Column="1"><StackPanel Spacing="8"><TextBlock Text="操作与草稿" FontWeight="SemiBold"/><TextBox Watermark="记录 ID (GUID)" Text="{Binding RecordIdText}"/><TextBox Watermark="Expected version" Text="{Binding ExpectedVersionText}"/><TextBox Watermark="Code" Text="{Binding Code}" MaxLength="50"/><TextBox Watermark="Name" Text="{Binding Name}" MaxLength="200"/><TextBox Watermark="Remark" Text="{Binding Remark}" MaxLength="500" AcceptsReturn="True" Height="80"/><TextBlock Text="Applied 核对需填写权威服务端版本；其他结果也必须有针对该操作的证据。" TextWrapping="Wrap"/><ComboBox ItemsSource="{Binding ReconcileOutcomes}" SelectedItem="{Binding ReconcileOutcome}"/><TextBox Watermark="服务端版本（Applied 必填）" Text="{Binding ServerVersionText}"/><TextBox Watermark="非敏感权威证据引用（核对必填）" Text="{Binding EvidenceReference}"/></StackPanel></ScrollViewer></Grid>
    <TextBlock Grid.Row="3" Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,12,0,0"/>
  </Grid>
</UserControl>
