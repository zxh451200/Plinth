<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Plinth.App.Modules.RemoteDemo.ViewModels"
             xmlns:data="using:Plinth.App.Modules.RemoteDemo.Data"
             xmlns:loc="using:Plinth.App.Localization"
             x:Class="Plinth.App.Modules.RemoteDemo.Views.RemoteDemoListView"
             x:CompileBindings="True" x:DataType="vm:RemoteDemoListViewModel">
  <Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto" ColumnDefinitions="*,320">
    <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
      <TextBlock Text="{loc:T remoteDemo.title}" FontSize="20" />
      <Button Content="{loc:T remoteDemo.refresh}" Command="{Binding RefreshCommand}" />
    </StackPanel>
    <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" IsEnabled="{Binding CanInteract}">
      <WrapPanel.Styles>
        <Style Selector="Button"><Setter Property="Margin" Value="0,0,8,4" /></Style>
        <Style Selector="TextBox"><Setter Property="Margin" Value="0,0,8,4" /></Style>
        <Style Selector="ComboBox"><Setter Property="Margin" Value="0,0,8,4" /></Style>
        <Style Selector="CheckBox"><Setter Property="Margin" Value="0,0,8,4" /></Style>
      </WrapPanel.Styles>
      <Button Content="{loc:T demo.new}" Command="{Binding NewCommand}" />
      <TextBox x:Name="SearchBox" Width="220" Text="{Binding SearchText}" MaxLength="200"
               PlaceholderText="{loc:T demo.search.placeholder}" AutomationProperties.Name="{loc:T demo.search.name}" />
      <ComboBox ItemsSource="{Binding SortLabels}" SelectedIndex="{Binding SortIndex}" Width="150"
                AutomationProperties.Name="{loc:T demo.list.sort}" />
      <CheckBox Content="{loc:T demo.list.descending}" IsChecked="{Binding Descending}" />
      <ComboBox ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" Width="90"
                AutomationProperties.Name="{loc:T demo.list.pageSize}" />
      <Button Content="{loc:T remoteDemo.search}" Command="{Binding SearchCommand}" />
      <Button Content="{loc:T demo.list.edit}" Click="OnEditRecordClick" IsEnabled="{Binding CanDelete}" />
    </WrapPanel>
    <Grid Grid.Row="2" RowDefinitions="Auto,*" Margin="0,12,12,0">
      <TextBlock Text="{loc:T demo.list.empty}" IsVisible="{Binding IsEmpty}" Margin="0,0,0,8" />
      <TableView x:Name="RecordsTable" Grid.Row="1"
                 Focusable="True"
                 ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                 IsEnabled="{Binding CanInteract}" AutomationProperties.Name="{loc:T demo.list.name}">
        <TableView.Columns>
          <TableViewColumn x:DataType="data:RemoteDemoRecord" Header="{loc:T demo.col.code}" Binding="{Binding Code}" Width="140" />
          <TableViewColumn x:DataType="data:RemoteDemoRecord" Header="{loc:T demo.col.name}" Binding="{Binding Name}" Width="200" />
          <TableViewColumn x:DataType="data:RemoteDemoRecord" Header="{loc:T demo.col.remark}" Binding="{Binding Remark}" Width="200" />
        </TableView.Columns>
      </TableView>
    </Grid>
    <ScrollViewer Grid.Row="2" Grid.Column="1" IsVisible="{Binding IsEditing}" Margin="0,12,0,0">
      <StackPanel Spacing="8" IsEnabled="{Binding CanInteract}">
        <TextBlock Text="{loc:T demo.form.title}" FontWeight="SemiBold" />
        <TextBlock Text="{loc:T demo.form.unsaved}" IsVisible="{Binding IsDirty}" />
        <TextBlock Text="{loc:T demo.col.code}" />
        <TextBox x:Name="EditCodeBox" Text="{Binding EditCode}" MaxLength="50" AutomationProperties.Name="{loc:T demo.col.code}" />
        <TextBlock Text="{Binding CodeError}" TextWrapping="Wrap" />
        <TextBlock Text="{loc:T demo.col.name}" />
        <TextBox Text="{Binding EditName}" MaxLength="200" AutomationProperties.Name="{loc:T demo.col.name}" />
        <TextBlock Text="{Binding NameError}" TextWrapping="Wrap" />
        <TextBlock Text="{loc:T demo.col.remark}" />
        <TextBox Text="{Binding EditRemark}" MaxLength="500" AcceptsReturn="True" Height="90"
                 AutomationProperties.Name="{loc:T demo.col.remark}" />
        <TextBlock Text="{Binding RemarkError}" TextWrapping="Wrap" />
        <WrapPanel>
          <Button Content="{loc:T demo.save}" Command="{Binding SaveCommand}" />
          <Button Content="{loc:T demo.cancel}" Command="{Binding CancelCommand}" />
          <Button Content="{loc:T demo.delete}" Command="{Binding AskDeleteCommand}" IsVisible="{Binding CanDelete}" />
        </WrapPanel>
        <StackPanel IsVisible="{Binding IsConfirmingDelete}" Spacing="8">
          <TextBlock Text="{loc:T demo.delete.confirm}" TextWrapping="Wrap" />
          <Button Content="{loc:T demo.delete}" Command="{Binding ConfirmDeleteCommand}" />
          <Button Content="{loc:T demo.delete.keep}" Command="{Binding CancelDeleteCommand}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="8" Margin="0,12,0,0">
      <WrapPanel IsEnabled="{Binding CanInteract}">
        <Button Content="{loc:T demo.list.previous}" Command="{Binding PreviousPageCommand}" />
        <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" />
        <Button Content="{loc:T demo.list.next}" Command="{Binding NextPageCommand}" />
        <TextBlock Text="{Binding TotalCount}" VerticalAlignment="Center" Margin="12,0" />
      </WrapPanel>
      <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Height="3" />
      <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</UserControl>
