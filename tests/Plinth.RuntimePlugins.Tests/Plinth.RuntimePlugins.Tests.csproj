<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <ProjectReference Include="../../tools/Plinth.PluginPilot/Plinth.PluginPilot.csproj" />
    <ProjectReference Include="../../samples/Plinth.EchoPlugin/Plinth.EchoPlugin.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Plinth.PluginFixture/Plinth.PluginFixture.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyPluginPeers" AfterTargets="Build">
    <ItemGroup>
      <FixtureFiles Include="../Plinth.PluginFixture/bin/$(Configuration)/$(TargetFramework)/*" />
      <SampleFiles Include="../../samples/Plinth.EchoPlugin/bin/$(Configuration)/$(TargetFramework)/*" />
    </ItemGroup>
    <Copy SourceFiles="@(FixtureFiles)" DestinationFolder="$(OutDir)fixture" />
    <Copy SourceFiles="@(SampleFiles)" DestinationFolder="$(OutDir)sample" />
  </Target>
</Project>
